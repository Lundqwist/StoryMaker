<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- drawn by tools\make-icon.ps1 -->
    <ApplicationIcon>StoryMaker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- the same icon inside the program, so every window can show it at every size -->
    <EmbeddedResource Include="StoryMaker.ico" LogicalName="StoryMaker.ico" />
    <!-- from lundqwist.se (Website2.0 client/public/images), converted from WebP -->
    <EmbeddedResource Include="Assets\lundqwist-emblem.png" LogicalName="lundqwist-emblem.png" />
    <EmbeddedResource Include="Assets\lundqwist-logo.png" LogicalName="lundqwist-logo.png" />
    <PackageReference Include="Anthropic" Version="13.9.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

</Project>