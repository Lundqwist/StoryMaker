<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- drawn by tools\make-icon.ps1 -->
    <ApplicationIcon>StoryMaker.ico</ApplicationIcon>
    <!-- the version shown in the program and in the installer's file name (tools\build-package.ps1) -->
    <Version>1.0.0</Version>
    <Product>StoryMaker</Product>
    <Company>Lundqwist</Company>
    <Copyright>© 2026 Bjarne Lundqwist, MIT license</Copyright>
    <Description>Turns the Lunar Journal into your World of Warcraft characters' stories</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- the same icon inside the program, so every window can show it at every size -->
    <EmbeddedResource Include="StoryMaker.ico" LogicalName="StoryMaker.ico" />
    <!-- from lundqwist.se (Website2.0 client/public/images), converted from WebP -->
    <EmbeddedResource Include="Assets\lundqwist-emblem.png" LogicalName="lundqwist-emblem.png" />
    <EmbeddedResource Include="Assets\lundqwist-logo.png" LogicalName="lundqwist-logo.png" />
    <!-- the sample character, for trying the program without the game (Sample\, made up for it) -->
    <EmbeddedResource Include="Sample\LunarJournal.lua" LogicalName="sample-journal.lua" />
    <EmbeddedResource Include="Sample\chapter.md" LogicalName="sample-chapter.md" />
    <PackageReference Include="Anthropic" Version="13.9.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

</Project>